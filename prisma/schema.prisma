// CloverEdge data model
// Design goal: content sourcing (manual CMS vs automated feeds) is left open —
// see DEVELOPMENT_PLAN.md. Monetization is a subscription paywall: three access
// tiers (anonymous visitor, free account, paid). Anonymous has no User record;
// FREE vs PAID is AccessTier below. Gating is a generic per-ContentItem flag —
// which content is actually premium is a product decision, not a schema one.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ContentType {
  NEWS
  BONUS_PROMO
  CASINO_REVIEW
  ODDS_UPDATE
  REGULATORY
  RESPONSIBLE_GAMBLING
  GAMEPLAY_VIDEO
}

enum ContentSource {
  MANUAL
  FEED
}

enum CasinoType {
  ONLINE
  LAND_BASED
  HYBRID
}

enum DigestFrequency {
  DAILY
  WEEKLY
  INSTANT
}

enum SubscriptionStatus {
  ACTIVE
  PAUSED
  UNSUBSCRIBED
}

// Content access tier — separate from SubscriptionStatus, which tracks
// newsletter delivery state, not payment. Billing fields (Stripe customer/
// subscription IDs, renewal date) get added in Phase 7 once payments are
// actually wired up — no point modeling them before there's a processor.
enum AccessTier {
  FREE
  PAID
}

model User {
  id                 String              @id @default(cuid())
  email              String              @unique
  name               String?
  createdAt          DateTime            @default(now())
  ageVerifiedAt      DateTime?           // 18+/21+ gate, jurisdiction-dependent
  jurisdiction       String?             // ISO country/state code, drives compliance + relevant content
  preferences        PreferenceTopic[]   @relation("UserPreferences")
  digestFrequency    DigestFrequency     @default(WEEKLY)
  subscriptionStatus SubscriptionStatus  @default(ACTIVE)
  tier               AccessTier          @default(FREE)
  issuesSent         NewsletterIssue[]
  comments           Comment[]
  isAdmin            Boolean             @default(false) // gates /admin — minimal role model for now
  isContentReviewer  Boolean             @default(false) // gates the video review queue; isAdmin implies this too, doesn't replace it
  reviewedVideos     VideoEmbed[]        // videos this user has reviewed/corrected — see DEVELOPMENT_PLAN.md human-in-the-loop section
  auditLogActions    AuditLogEntry[]     // consequential actions this user has taken — see DEVELOPMENT_PLAN.md governance section

  // Auth.js (magic-link email sign-in) — standard adapter fields/relations.
  emailVerified DateTime?
  accounts      Account[]
  sessions      Session[]
}

// --- Auth.js Prisma adapter models (magic-link email auth) ---

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
}

// A topic/category a user can opt into, e.g. "Online Slots", "Land-Based Openings",
// "Bonus Offers", "Sports Betting", "Regulatory News", "Responsible Gambling".
// Also doubles as a region/jurisdiction tag when `kind = REGION`.
model PreferenceTopic {
  id        String        @id @default(cuid())
  slug      String        @unique
  label     String
  kind      TopicKind     @default(TOPIC)
  users     User[]        @relation("UserPreferences")
  content   ContentItem[] @relation("ContentTopics")

  // Admin override for the Trending Now widget (/admin/homepage). Null =
  // not pinned. When ANY topic has a non-null value, Trending Now shows
  // exactly the pinned set in this order, full override — otherwise it
  // falls back to the computed GuestSignal aggregate as before.
  pinnedTrendingOrder Int?
}

enum TopicKind {
  TOPIC
  REGION
  CASINO_TYPE
}

model Casino {
  id          String     @id @default(cuid())
  name        String
  slug        String     @unique
  type        CasinoType
  jurisdiction String?
  website     String?
  ratingAvg   Float?
  content     ContentItem[]
  bonuses     Bonus[]
  comments    Comment[]
}

model Bonus {
  id        String    @id @default(cuid())
  casino    Casino    @relation(fields: [casinoId], references: [id])
  casinoId  String
  title     String
  terms     String?
  expiresAt DateTime?
  createdAt DateTime  @default(now())
}

// Single table for all editorial content regardless of where it came from
// (manual CMS entry today, automated feed ingestion later).
model ContentItem {
  id          String        @id @default(cuid())
  title       String
  slug        String        @unique
  excerpt     String?
  body        String
  contentType ContentType
  source      ContentSource @default(MANUAL)
  sourceUrl   String?       // set when source = FEED
  tier        AccessTier    @default(FREE) // FREE visible to everyone incl. guests; PAID requires an active subscriber
  casino      Casino?       @relation(fields: [casinoId], references: [id])
  casinoId    String?
  topics      PreferenceTopic[] @relation("ContentTopics")
  publishedAt DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  // Set when contentType = GAMEPLAY_VIDEO. One-to-one: a video embed is
  // always wrapped by exactly one ContentItem so it can carry topics/tier
  // like everything else, without duplicating that plumbing on VideoEmbed.
  video   VideoEmbed? @relation(fields: [videoId], references: [id])
  videoId String?     @unique

  // Fixed editorial carousel ("Top Story") — deliberately NOT part of
  // personalization/guest-signal scoring. Curated by an editor (currently
  // via seed.ts; an admin UI for this is a later item), same set for every
  // visitor. featuredOrder is nullable so non-featured items don't need one.
  featured      Boolean @default(false)
  featuredOrder Int?
}

// Snapshot of a sent (or previewed) newsletter issue, for history/debugging
// and eventually open/click analytics.
model NewsletterIssue {
  id         String    @id @default(cuid())
  user       User      @relation(fields: [userId], references: [id])
  userId     String
  subject    String
  sentAt     DateTime?
  contentIds String[]  // ContentItem ids included in this issue
  createdAt  DateTime  @default(now())
}

enum CommentStatus {
  PENDING
  APPROVED
  REJECTED
}

// User reviews/comments on a casino experience — "liked or didn't like this
// casino" plus free-text. `casinoId` is nullable to also allow general
// experience feedback not tied to a specific casino. When SlotGame lands
// (Phase 3), add a nullable slotGameId here the same way rather than a
// separate table — same shape, same moderation flow.
model Comment {
  id        String        @id @default(cuid())
  author    User          @relation(fields: [authorId], references: [id])
  authorId  String
  casino    Casino?       @relation(fields: [casinoId], references: [id])
  casinoId  String?
  body      String
  rating    Int?          // 1-5, optional — supports a quick "liked it / didn't" without forcing a score
  status    CommentStatus @default(PENDING)
  createdAt DateTime      @default(now())
}

enum ModuleType {
  HERO
  RAIL
  TRENDING
}

// Editorial config for a homepage section — which rail, in what order, filtered
// to which topic. Reordered via /admin/homepage. `topicSlug` is null for
// HERO (this row is just the on/off toggle for the fixed "Top Story" carousel —
// the actual curated items are ContentItem.featured/featuredOrder, deliberately
// NOT part of personalization scoring) and TRENDING (computed from GuestSignal).
model HomepageModule {
  id        String     @id @default(cuid())
  key       String     @unique
  title     String
  type      ModuleType @default(RAIL)
  topicSlug String?
  order     Int        @default(0)
  active    Boolean    @default(true)
}

// Anonymous, cookie-keyed engagement signal — no PII, just "this browser
// clicked into this topic N times." Used only to reorder/emphasize existing
// homepage rails for guests, and to compute the Trending module. Never used
// to hide content or identify a person.
model GuestSignal {
  id        String   @id @default(cuid())
  guestId   String
  topicSlug String
  weight    Int      @default(1)
  updatedAt DateTime @updatedAt

  @@unique([guestId, topicSlug])
}

// All values the classification exercise identified as real categories,
// even though initial content only populates SLOTS — keeping the enum
// complete now avoids a migration when poker/roulette/sports betting videos
// get added later.
enum VideoGameType {
  SLOTS
  BLACKJACK
  ROULETTE
  POKER
  SPORTS_BETTING
  OTHER
}

enum VenueType {
  ONLINE
  LAND_BASED
  UNKNOWN
}

enum VideoSentiment {
  WIN
  LOSS
  MIXED
  UNKNOWN
}

// Broad bet-size tier — filterable, matches how players actually talk about
// denomination, rather than forcing an exact amount out of every video.
// See DEVELOPMENT_PLAN.md "Current priority" section for the buckets-vs-
// exact-amount decision.
enum Denomination {
  PENNY      // roughly $0.01-$0.24
  LOW        // roughly $0.25-$4.99
  MID        // roughly $5-$24.99
  HIGH_LIMIT // roughly $25+
  UNKNOWN
}

// Human-in-the-loop review status for an AI-classified video. Videos
// publish immediately on AI classification (decided — see
// DEVELOPMENT_PLAN.md); this tracks whether a staff member has since
// confirmed or corrected the tags, not whether the video is visible.
enum VideoReviewState {
  UNREVIEWED
  VERIFIED
  NEEDS_FIXING
}

// The company that manufactures/develops the game itself (Aristocrat, IGT,
// Light & Wonder, etc.) — distinct from VideoEmbed.channelTitle, which is
// who POSTED the video. Needed for RTP/volatility-driven recommendations,
// not just video attribution. A video can reference a provider directly
// (classifier identified the manufacturer but not the exact game) and/or
// via its SlotGame once that's known.
model GameProvider {
  id    String     @id @default(cuid())
  name  String     @unique
  slug  String     @unique
  games SlotGame[]
  videos VideoEmbed[]
}

// A specific, named slot title (e.g. "Buffalo Gold," "Dragon Link") — pulled
// forward from its original Phase 3 scope (ratings) because specific-game
// search is now core to video discovery, not a ratings-only feature. rtp/
// volatility stay nullable since they're populated by the Phase 3 rating
// work, not required just to tag a video with which game it shows.
// Slots-only scope for now (decided) — table-game variants are a separate,
// less standardized kind of "specific game," deferred.
model SlotGame {
  id         String        @id @default(cuid())
  name       String
  slug       String        @unique
  provider   GameProvider? @relation(fields: [providerId], references: [id])
  providerId String?
  rtp        Float?        // return-to-player %, when known (Phase 3)
  volatility String?       // freeform ("low"/"medium"/"high") until a real rubric exists (Phase 3)
  videos     VideoEmbed[]
}

// Generic audit trail for consequential admin/moderation actions — who did
// what, when, to what. A governance/business-continuity foundation (see
// DEVELOPMENT_PLAN.md "Business continuity & governance"): decisions and
// changes need to be attributable and reconstructable without depending on
// one person's memory. Deliberately generic (string action/entityType)
// rather than one table per action type, so a new admin action doesn't need
// a schema change just to get logged.
model AuditLogEntry {
  id         String   @id @default(cuid())
  actor      User?    @relation(fields: [actorId], references: [id])
  actorId    String?
  action     String   // e.g. "video.review", "homepage.reorder", "comment.moderate"
  entityType String   // e.g. "VideoEmbed", "HomepageModule", "Comment"
  entityId   String
  detail     Json?    // freeform before/after or context, when useful
  createdAt  DateTime @default(now())
}

// A YouTube video pulled via the Data API (official metadata: title,
// channel, duration, thumbnail, view count) plus gameType/venueType/
// sentiment/slotGame/gameProvider/denomination, which are NOT official API
// fields — they're filled in by the classification process (title/
// description/tags/thumbnail review) since YouTube doesn't expose
// structured "this is slots gameplay, a big win, on a $5 machine" metadata
// itself. See DEVELOPMENT_PLAN.md Phase 4 / "Current priority" for the
// classification notes and build sequence this was built from.
model VideoEmbed {
  id                 String         @id @default(cuid())
  youtubeVideoId     String         @unique
  title              String
  channelTitle       String
  thumbnailUrl       String
  durationSeconds    Int
  gameType           VideoGameType
  venueType          VenueType      @default(UNKNOWN)
  sentiment          VideoSentiment @default(UNKNOWN)
  viewCount          Int?
  youtubePublishedAt DateTime?
  fetchedAt          DateTime       @default(now())
  content            ContentItem?

  // Specific-game + provider identification (nullable — not every video
  // will be confidently classified to an exact game/provider, especially
  // early in the AI pipeline's tiering).
  slotGame       SlotGame?     @relation(fields: [slotGameId], references: [id])
  slotGameId     String?
  gameProvider   GameProvider? @relation(fields: [gameProviderId], references: [id])
  gameProviderId String?

  // Denomination/bet size — bucketed for filtering, exact value stored
  // alongside when a creator states one.
  denomination      Denomination @default(UNKNOWN)
  denominationExact Float?

  // Human-in-the-loop review state (publish-then-review, decided).
  reviewState     VideoReviewState @default(UNREVIEWED)
  reviewedBy      User?            @relation(fields: [reviewedById], references: [id])
  reviewedById    String?
  reviewedAt      DateTime?
  confidenceScore Float?           // 0-1, from the AI classification call
  staffNotes      String?          // internal only, never rendered to visitors
}
