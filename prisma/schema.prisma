// CasinoWatch data model
// Design goal: content sourcing (manual CMS vs automated feeds) is left open —
// see DEVELOPMENT_PLAN.md. Monetization is a subscription paywall: three access
// tiers (anonymous visitor, free account, paid). Anonymous has no User record;
// FREE vs PAID is AccessTier below. Gating is a generic per-ContentItem flag —
// which content is actually premium is a product decision, not a schema one.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ContentType {
  NEWS
  BONUS_PROMO
  CASINO_REVIEW
  ODDS_UPDATE
  REGULATORY
  RESPONSIBLE_GAMBLING
}

enum ContentSource {
  MANUAL
  FEED
}

enum CasinoType {
  ONLINE
  LAND_BASED
  HYBRID
}

enum DigestFrequency {
  DAILY
  WEEKLY
  INSTANT
}

enum SubscriptionStatus {
  ACTIVE
  PAUSED
  UNSUBSCRIBED
}

// Content access tier — separate from SubscriptionStatus, which tracks
// newsletter delivery state, not payment. Billing fields (Stripe customer/
// subscription IDs, renewal date) get added in Phase 7 once payments are
// actually wired up — no point modeling them before there's a processor.
enum AccessTier {
  FREE
  PAID
}

model User {
  id                 String              @id @default(cuid())
  email              String              @unique
  name               String?
  createdAt          DateTime            @default(now())
  ageVerifiedAt      DateTime?           // 18+/21+ gate, jurisdiction-dependent
  jurisdiction       String?             // ISO country/state code, drives compliance + relevant content
  preferences        PreferenceTopic[]   @relation("UserPreferences")
  digestFrequency    DigestFrequency     @default(WEEKLY)
  subscriptionStatus SubscriptionStatus  @default(ACTIVE)
  tier               AccessTier          @default(FREE)
  issuesSent         NewsletterIssue[]
  comments           Comment[]
  isAdmin            Boolean             @default(false) // gates /admin — minimal role model for now

  // Auth.js (magic-link email sign-in) — standard adapter fields/relations.
  emailVerified DateTime?
  accounts      Account[]
  sessions      Session[]
}

// --- Auth.js Prisma adapter models (magic-link email auth) ---

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
}

// A topic/category a user can opt into, e.g. "Online Slots", "Land-Based Openings",
// "Bonus Offers", "Sports Betting", "Regulatory News", "Responsible Gambling".
// Also doubles as a region/jurisdiction tag when `kind = REGION`.
model PreferenceTopic {
  id        String        @id @default(cuid())
  slug      String        @unique
  label     String
  kind      TopicKind     @default(TOPIC)
  users     User[]        @relation("UserPreferences")
  content   ContentItem[] @relation("ContentTopics")
}

enum TopicKind {
  TOPIC
  REGION
  CASINO_TYPE
}

model Casino {
  id          String     @id @default(cuid())
  name        String
  slug        String     @unique
  type        CasinoType
  jurisdiction String?
  website     String?
  ratingAvg   Float?
  content     ContentItem[]
  bonuses     Bonus[]
  comments    Comment[]
}

model Bonus {
  id        String    @id @default(cuid())
  casino    Casino    @relation(fields: [casinoId], references: [id])
  casinoId  String
  title     String
  terms     String?
  expiresAt DateTime?
  createdAt DateTime  @default(now())
}

// Single table for all editorial content regardless of where it came from
// (manual CMS entry today, automated feed ingestion later).
model ContentItem {
  id          String        @id @default(cuid())
  title       String
  slug        String        @unique
  excerpt     String?
  body        String
  contentType ContentType
  source      ContentSource @default(MANUAL)
  sourceUrl   String?       // set when source = FEED
  tier        AccessTier    @default(FREE) // FREE visible to everyone incl. guests; PAID requires an active subscriber
  casino      Casino?       @relation(fields: [casinoId], references: [id])
  casinoId    String?
  topics      PreferenceTopic[] @relation("ContentTopics")
  publishedAt DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

// Snapshot of a sent (or previewed) newsletter issue, for history/debugging
// and eventually open/click analytics.
model NewsletterIssue {
  id         String    @id @default(cuid())
  user       User      @relation(fields: [userId], references: [id])
  userId     String
  subject    String
  sentAt     DateTime?
  contentIds String[]  // ContentItem ids included in this issue
  createdAt  DateTime  @default(now())
}

enum CommentStatus {
  PENDING
  APPROVED
  REJECTED
}

// User reviews/comments on a casino experience — "liked or didn't like this
// casino" plus free-text. `casinoId` is nullable to also allow general
// experience feedback not tied to a specific casino. When SlotGame lands
// (Phase 3), add a nullable slotGameId here the same way rather than a
// separate table — same shape, same moderation flow.
model Comment {
  id        String        @id @default(cuid())
  author    User          @relation(fields: [authorId], references: [id])
  authorId  String
  casino    Casino?       @relation(fields: [casinoId], references: [id])
  casinoId  String?
  body      String
  rating    Int?          // 1-5, optional — supports a quick "liked it / didn't" without forcing a score
  status    CommentStatus @default(PENDING)
  createdAt DateTime      @default(now())
}

enum ModuleType {
  HERO
  RAIL
  TRENDING
}

// Editorial config for a homepage section — which rail, in what order, filtered
// to which topic. Reordered via /admin/homepage. `topicSlug` is null for
// HERO (picks latest content overall) and TRENDING (computed from GuestSignal).
model HomepageModule {
  id        String     @id @default(cuid())
  key       String     @unique
  title     String
  type      ModuleType @default(RAIL)
  topicSlug String?
  order     Int        @default(0)
  active    Boolean    @default(true)
}

// Anonymous, cookie-keyed engagement signal — no PII, just "this browser
// clicked into this topic N times." Used only to reorder/emphasize existing
// homepage rails for guests, and to compute the Trending module. Never used
// to hide content or identify a person.
model GuestSignal {
  id        String   @id @default(cuid())
  guestId   String
  topicSlug String
  weight    Int      @default(1)
  updatedAt DateTime @updatedAt

  @@unique([guestId, topicSlug])
}
